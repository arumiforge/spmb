#!/usr/bin/env bash
# spmb — server CLI for the SPMB Docker stacks (docs/deployment.md, D-066…D-068).
#
# Installed by `spmb init` as a symlink: /usr/local/bin/spmb -> <checkout>/deploy/server/spmb.
# Runs as root on the server. The checkout (/opt/apps/spmb/src) is a plain git clone whose
# read access the developer sets up; this script never handles keys or tokens.
#
# Layout:
#   /opt/apps/PORTS                     ports taken on this server, one "<port> <name>" per line
#   /opt/apps/spmb/src/                 git checkout (follows the commit running on staging)
#   /opt/apps/spmb/<env>/stack.env      port, image tag, database passwords (made by `init`)
#   /opt/apps/spmb/<env>/app.env        CodeIgniter .env, mounted read-only into the app container
#   /opt/apps/spmb/<env>/compose.yaml   copied from deploy/compose.yaml of the deployed commit
#   /opt/apps/spmb/<env>/backups/       spmb-<env>-<time>.tar, kept 14 days
#
# Overrides for testing: SPMB_ROOT (default /opt/apps), SPMB_SRC (default $SPMB_ROOT/spmb/src).
#
# The whole script is one function called on the last line, so a `git checkout` that changes
# this file while it runs cannot change what bash executes.

# Shell snippets in single quotes run inside the containers, where $MYSQL_* are set.
# shellcheck disable=SC2016
main() {
set -Eeuo pipefail

SPMB_ROOT="${SPMB_ROOT:-/opt/apps}"
APP_DIR="$SPMB_ROOT/spmb"
SRC="${SPMB_SRC:-$APP_DIR/src}"
PORTS_FILE="$SPMB_ROOT/PORTS"
PORT_MIN=8100
PORT_MAX=8199
KEEP_IMAGES=5
KEEP_BACKUP_DAYS=14
OFFSITE_FILE="$APP_DIR/offsite.env"
OFFSITE_LAST="$APP_DIR/offsite.last"
OFFSITE_HOST=spmb
ASSUME_YES=0
ROLLBACK_PREVIOUS=""
LAST_BACKUP=""

say()  { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Usage: spmb <command> [arguments]

  check                       Where this server is (fresh, set up, tunnel, repository, staging,
                              production) and the next command. Read-only (check.sh).
  up <env> [domain] [ref]     All in one, safe to repeat: init when needed, deploy when not running,
                              first Super Admin when there is none, health check. Start here.
  init <env> <domain>         Prepare an environment (staging | production): folder, passwords,
                              encryption key, a free local port, daily backup timer.
  deploy staging [ref]        Fetch, build the images of <ref> (default origin/main), back up,
                              start, migrate, import bundled data, health check.
  deploy production [ref]     Promote the image running on staging (default), or build <ref>.
  rollback <env>              Switch back to the previous image (the database is not rolled back).
  status                      Environments, ports, images, containers.
  logs <env> [service]        Follow the logs (services: web, app, db).
  backup <env>                Database dump + uploaded files into <env>/backups/ (kept 14 days), then
                              an encrypted copy off-site when `offsite setup` was done.
  restore <env> <file>        Restore a backup made by `spmb backup` (asks first).
  spark <env> <args...>       Run `php spark <args...>` in the app container.
  domain <env> <domain>       Change the domain of an environment (stack.env, app.baseURL), restart
                              the app and check it; prints the Cloudflare steps.
  offsite setup               Connect off-site backups (restic, encrypted) to an S3 bucket such as
                              Cloudflare R2; asks for the bucket URL and keys.
  offsite status              Snapshots kept off-site and the last upload.
  offsite get <env> [id]      Download an off-site backup (default: latest) into <env>/backups/,
                              ready for `spmb restore`.

Options: -y / --yes answers "yes" to confirmations (production deploy, restore, production domain).
USAGE
}

valid_domain() {
    [[ "${1:-}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]
}

need_root() { [ "$(id -u)" -eq 0 ] || die "Run as root (sudo spmb ...)."; }

check_env() {
    case "${1:-}" in
        staging|production) ;;
        *) die "Environment must be 'staging' or 'production' (got '${1:-}')." ;;
    esac
}

env_dir() { printf '%s/%s' "$APP_DIR" "$1"; }

require_init() {
    [ -f "$(env_dir "$1")/stack.env" ] || die "'$1' is not initialised. Run: spmb init $1 <domain>"
}

# Read / write KEY=value lines in stack.env (values are simple words, written by this script).
get_var() {
    local file="$1" key="$2"
    [ -f "$file" ] || return 0
    sed -n "s/^${key}=//p" "$file" | tail -n 1
}
set_var() {
    local file="$1" key="$2" value="$3"
    if grep -q "^${key}=" "$file"; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$file"
    else
        printf '%s=%s\n' "$key" "$value" >> "$file"
    fi
}

confirm() {
    local question="$1" answer
    [ "$ASSUME_YES" = 1 ] && return 0
    [ -t 0 ] || die "$question — not confirmed (no terminal). Add --yes to confirm."
    read -r -p "$question [y/N] " answer
    case "$answer" in y|Y|yes|ya|Ya) return 0 ;; *) die "Cancelled." ;; esac
}

dc() {
    local env="$1"; shift
    local dir; dir="$(env_dir "$env")"
    docker compose --project-directory "$dir" -p "spmb-$env" \
        --env-file "$dir/stack.env" -f "$dir/compose.yaml" "$@"
}

tty_flag() { if [ -t 0 ] && [ -t 1 ]; then printf ''; else printf -- '-T'; fi; }

lock() {
    mkdir -p "$APP_DIR"
    exec 9> "$APP_DIR/.lock"
    flock -n 9 || die "Another spmb command is running (lock $APP_DIR/.lock)."
}

# --- host integration: CLI link and backup timer ------------------------------------------
install_host_bits() {
    local self
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    if [ "$self" != "$(readlink -f /usr/local/bin/spmb 2>/dev/null || true)" ]; then
        ln -sfn "$self" /usr/local/bin/spmb
        say "   /usr/local/bin/spmb -> $self"
    fi
    [ -d /run/systemd/system ] || { warn "systemd is not running here; backup timer not installed."; return 0; }
    cat > /etc/systemd/system/spmb-backup@.service <<'UNIT'
[Unit]
Description=SPMB daily backup (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/spmb backup %i
Nice=10
IOSchedulingClass=idle
UNIT
    cat > /etc/systemd/system/spmb-backup@.timer <<'UNIT'
[Unit]
Description=SPMB daily backup (%i)

[Timer]
OnCalendar=*-*-* 01:30:00 Asia/Jakarta
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload
}

enable_backup_timer() {
    [ -d /run/systemd/system ] || return 0
    if systemctl enable --now "spmb-backup@$1.timer" >/dev/null 2>&1; then
        say "   Daily backup timer: spmb-backup@$1.timer"
    else
        warn "Could not enable spmb-backup@$1.timer."
    fi
}

# --- ports ---------------------------------------------------------------------------------
port_in_use() {
    local port="$1"
    grep -qE "^${port}[[:space:]]" "$PORTS_FILE" 2>/dev/null && return 0
    if command -v ss >/dev/null; then
        [ -n "$(ss -ltnH "sport = :$port" 2>/dev/null)" ] && return 0
    fi
    # Ports Docker publishes without a listening proxy process (userland-proxy off), any stack.
    if command -v docker >/dev/null; then
        docker ps --format '{{.Ports}}' 2>/dev/null | grep -qF ":${port}->" && return 0
    fi
    return 1
}

take_port() {
    local name="$1" port
    mkdir -p "$SPMB_ROOT"
    if [ ! -f "$PORTS_FILE" ]; then
        printf '# Local ports taken by app stacks on this server: <port> <name>\n' > "$PORTS_FILE"
        chmod 0644 "$PORTS_FILE"
    fi
    port="$(awk -v n="$name" '$2 == n {print $1; exit}' "$PORTS_FILE")"
    if [ -n "$port" ]; then printf '%s' "$port"; return 0; fi
    for ((port = PORT_MIN; port <= PORT_MAX; port++)); do
        if ! port_in_use "$port"; then
            printf '%s %s\n' "$port" "$name" >> "$PORTS_FILE"
            printf '%s' "$port"
            return 0
        fi
    done
    die "No free port between $PORT_MIN and $PORT_MAX (see $PORTS_FILE)."
}

# --- init ----------------------------------------------------------------------------------
cmd_init() {
    local env="${1:-}" domain="${2:-}"
    check_env "$env"
    valid_domain "$domain" \
        || die "Give the domain of this environment, e.g. spmb init $env staging.example.sch.id"
    need_root
    command -v docker >/dev/null || die "Docker is not installed (run deploy/server/setup.sh first)."
    command -v openssl >/dev/null || die "openssl is missing."
    lock
    local dir; dir="$(env_dir "$env")"

    step "Environment $env ($domain)"
    install -d -m 0700 "$dir" "$dir/backups"

    if [ -f "$dir/stack.env" ]; then
        say "   $dir/stack.env exists; passwords, key and port are kept."
        local old; old="$(get_var "$dir/stack.env" SPMB_DOMAIN)"
        [ "$old" = "$domain" ] || warn "Domain stays '$old' (edit $dir/stack.env and app.env to change it)."
    else
        local port db_pass root_pass
        port="$(take_port "spmb-$env")"
        db_pass="$(openssl rand -hex 24)"
        root_pass="$(openssl rand -hex 24)"
        umask 077
        cat > "$dir/stack.env" <<STACK
# SPMB $env stack (made by spmb init). Keep it on the server; never commit it.
SPMB_ENV=$env
SPMB_DOMAIN=$domain
SPMB_PORT=$port
SPMB_TAG=
SPMB_PREVIOUS_TAG=
SPMB_DB_PASSWORD=$db_pass
SPMB_DB_ROOT_PASSWORD=$root_pass
STACK
        cat > "$dir/app.env" <<APPENV
# CodeIgniter settings of the SPMB $env stack (made by spmb init).
# encryption.key protects 2FA secrets and other encrypted data: keep a copy off the server.
CI_ENVIRONMENT = production
app.baseURL = 'https://$domain/'

database.default.hostname = db
database.default.database = spmb
database.default.username = spmb
database.default.password = $db_pass
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

encryption.key = hex2bin:$(openssl rand -hex 32)
APPENV
        umask 022
        say "   Port 127.0.0.1:$port, database passwords and encryption.key created in $dir."
    fi
    # The app container (www-data, uid/gid 33) reads app.env through a read-only bind mount.
    chown root:33 "$dir/app.env"
    chmod 0640 "$dir/app.env"
    chmod 0600 "$dir/stack.env"

    install_host_bits
    enable_backup_timer "$env"

    local port; port="$(get_var "$dir/stack.env" SPMB_PORT)"
    say
    say "Next:"
    say " - Cloudflare Tunnel public hostname: $domain -> http://127.0.0.1:$port"
    if [ "$env" = staging ]; then
        say " - spmb deploy staging"
    else
        say " - spmb deploy production   (promotes the image running on staging)"
    fi
    say " - First time only: spmb spark $env spmb:install"
}

# --- images --------------------------------------------------------------------------------
resolve_commit() {
    local ref="$1"
    git -C "$SRC" rev-parse --verify --quiet "${ref}^{commit}" \
        || die "Unknown commit, branch or tag '$ref' in $SRC."
}

fetch_src() {
    [ -d "$SRC/.git" ] || [ -f "$SRC/.git" ] \
        || die "No git checkout in $SRC. Clone the repository there first (docs/deployment.md)."
    step "Fetching $SRC"
    git -C "$SRC" fetch --prune --tags origin
}

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

image_commit() {
    docker image inspect -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "spmb-app:$1" 2>/dev/null || true
}

build_images() {
    local sha="$1" tag="${1:0:12}" target
    if image_exists "spmb-app:$tag" && image_exists "spmb-web:$tag"; then
        say "   Images spmb-app:$tag and spmb-web:$tag exist; not rebuilt."
        return 0
    fi
    step "Building $tag ($(git -C "$SRC" log -1 --format='%cs %s' "$sha"))"
    for target in app web; do
        git -C "$SRC" archive --format=tar "$sha" \
            | DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile --target "$target" \
                --label "org.opencontainers.image.revision=$sha" \
                --label "org.opencontainers.image.title=spmb-$target" \
                -t "spmb-$target:$tag" -
    done
}

prune_images() {
    local keep tag
    keep=" $(for e in staging production; do
        get_var "$(env_dir "$e")/stack.env" SPMB_TAG
        get_var "$(env_dir "$e")/stack.env" SPMB_PREVIOUS_TAG
    done | tr '\n' ' ') "
    # Newest first; the newest $KEEP_IMAGES tags are kept as well as every tag in use.
    docker image ls spmb-app --format '{{.Tag}}' | awk -v n="$KEEP_IMAGES" 'NR > n' | while read -r tag; do
        [ -n "$tag" ] || continue
        case "$keep" in *" $tag "*) continue ;; esac
        docker image rm "spmb-app:$tag" "spmb-web:$tag" >/dev/null 2>&1 || true
        say "   Removed old image $tag"
    done
    docker image prune -f >/dev/null 2>&1 || true
}

# --- health --------------------------------------------------------------------------------
health_check() {
    local env="$1" dir port domain code
    dir="$(env_dir "$env")"
    port="$(get_var "$dir/stack.env" SPMB_PORT)"
    domain="$(get_var "$dir/stack.env" SPMB_DOMAIN)"
    for _ in $(seq 1 20); do
        code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 \
            -H "Host: $domain" -H 'X-Forwarded-Proto: https' "http://127.0.0.1:$port/" || true)"
        if [ "$code" = 200 ]; then
            say "   Health check: HTTP 200 on / ($env, port $port)."
            return 0
        fi
        sleep 3
    done
    warn "Health check failed: HTTP ${code:-none} on http://127.0.0.1:$port/ ($env)."
    return 1
}

stack_running() { [ -f "$(env_dir "$1")/compose.yaml" ] && [ -n "$(dc "$1" ps -q db 2>/dev/null)" ]; }

# Start <env> on image <tag>: copy compose.yaml of that commit, back up, up, migrate, import, clear cache, check.
activate() {
    local env="$1" tag="$2" dir sha current
    dir="$(env_dir "$env")"
    sha="$(image_commit "$tag")"
    [ -n "$sha" ] || die "Image spmb-app:$tag has no commit label."
    current="$(get_var "$dir/stack.env" SPMB_TAG)"
    ROLLBACK_PREVIOUS="$(get_var "$dir/stack.env" SPMB_PREVIOUS_TAG)"

    git -C "$SRC" show "$sha:deploy/compose.yaml" > "$dir/compose.yaml.new" \
        || die "deploy/compose.yaml not found in $sha."

    if [ -n "$current" ] && stack_running "$env"; then
        step "Backup before the update"
        cmd_backup_unlocked "$env"
    fi

    mv -f "$dir/compose.yaml.new" "$dir/compose.yaml"
    if [ "$current" != "$tag" ]; then
        set_var "$dir/stack.env" SPMB_PREVIOUS_TAG "$current"
        set_var "$dir/stack.env" SPMB_TAG "$tag"
    fi

    step "Starting spmb-$env on $tag"
    if ! dc "$env" up -d --remove-orphans --wait --wait-timeout 300; then
        dc "$env" ps || true
        dc "$env" logs --tail 50 || true
        fail_and_roll_back "$env" "$current" "containers did not become healthy"
    fi

    step "Migrations and bundled data"
    if ! dc "$env" exec -T app php spark migrate --all \
        || ! dc "$env" exec -T app php spark referensi:import --bawaan; then
        fail_and_roll_back "$env" "$current" "migration or data import failed"
    fi
    # Cached values (e.g. the visitor numbers in the footer) may be shaped by the old code: start clean.
    dc "$env" exec -T app php spark cache:clear >/dev/null 2>&1 || warn "cache:clear failed; continuing."

    if ! health_check "$env"; then
        dc "$env" logs --tail 50 app web || true
        fail_and_roll_back "$env" "$current" "health check failed"
    fi

    printf '%s %s %s %s\n' "$(date -Iseconds)" "$env" "$tag" "$sha" >> "$dir/deploys.log"
    step "Cleaning old images"
    prune_images
    say
    say "spmb-$env runs $tag ($sha)."
}

fail_and_roll_back() {
    local env="$1" previous="$2" reason="$3" dir
    dir="$(env_dir "$env")"
    warn "Deploy of $env stopped: $reason."
    if [ -n "$previous" ] && [ "$previous" != "$(get_var "$dir/stack.env" SPMB_TAG)" ]; then
        warn "Switching back to the previous image $previous."
        set_var "$dir/stack.env" SPMB_TAG "$previous"
        set_var "$dir/stack.env" SPMB_PREVIOUS_TAG "${ROLLBACK_PREVIOUS:-}"
        local sha; sha="$(image_commit "$previous")"
        [ -z "$sha" ] || git -C "$SRC" show "$sha:deploy/compose.yaml" > "$dir/compose.yaml" || true
        dc "$env" up -d --remove-orphans --wait --wait-timeout 300 || true
        health_check "$env" || true
        warn "Migrations that already ran are not undone. If the old version misbehaves,"
        warn "restore the backup made before the deploy: ls $dir/backups/; spmb restore $env <file>"
    fi
    exit 1
}

cmd_deploy() {
    local env="${1:-}" ref="${2:-}" sha tag
    check_env "$env"
    need_root
    require_init "$env"
    lock
    install_host_bits
    fetch_src

    if [ "$env" = staging ]; then
        sha="$(resolve_commit "${ref:-origin/main}")"
        build_images "$sha"
        tag="${sha:0:12}"
        activate staging "$tag"
        # The checkout follows staging, so this CLI matches what was just deployed.
        if [ -z "$(git -C "$SRC" status --porcelain --untracked-files=no)" ]; then
            git -C "$SRC" checkout -q --detach "$sha"
        else
            warn "$SRC has local changes; checkout left as it is."
        fi
        return 0
    else
        if [ -z "$ref" ]; then
            tag="$(get_var "$(env_dir staging)/stack.env" SPMB_TAG)"
            [ -n "$tag" ] || die "Staging runs no image yet. Deploy staging first, or give a ref: spmb deploy production <ref>"
            if ! image_exists "spmb-app:$tag" || ! image_exists "spmb-web:$tag"; then
                die "Images for $tag are missing."
            fi
            sha="$(image_commit "$tag")"
            say "   Promoting the image running on staging: $tag"
        else
            sha="$(resolve_commit "$ref")"
            tag="${sha:0:12}"
            [ "$tag" = "$(get_var "$(env_dir staging)/stack.env" SPMB_TAG)" ] \
                || warn "$tag is not what runs on staging: production gets a build that staging has not tested."
            build_images "$sha"
        fi
        say "   $(git -C "$SRC" log -1 --format='%h %cs %s' "$sha" 2>/dev/null || echo "$sha")"
        confirm "Deploy $tag to PRODUCTION ($(get_var "$(env_dir production)/stack.env" SPMB_DOMAIN))?"
    fi
    activate "$env" "$tag"
}

# --- up: from wherever this environment is to a running site --------------------------------
superadmin_count() {
    dc "$1" exec -T db sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -B -e "SELECT COUNT(*) FROM spmb.auth_groups_users WHERE \`group\` = '"'"'superadmin'"'"'" 2>/dev/null' \
        2>/dev/null | tr -dc '0-9' || true
}

cmd_up() {
    local env="${1:-}" domain="" ref="" dir tag
    check_env "$env"; shift
    if [ -n "${1:-}" ] && valid_domain "$1"; then domain="$1"; shift; fi
    ref="${1:-}"
    need_root
    dir="$(env_dir "$env")"

    if [ ! -f "$dir/stack.env" ]; then
        [ -n "$domain" ] || die "'$env' is new: give its domain, e.g. spmb up $env $( [ "$env" = staging ] && echo staging.)example.sch.id"
        cmd_init "$env" "$domain"
    elif [ -n "$domain" ] && [ "$domain" != "$(get_var "$dir/stack.env" SPMB_DOMAIN)" ]; then
        die "$env uses $(get_var "$dir/stack.env" SPMB_DOMAIN). To change the domain: spmb domain $env $domain"
    fi

    tag="$(get_var "$dir/stack.env" SPMB_TAG)"
    if [ -n "$ref" ] || [ -z "$tag" ]; then
        cmd_deploy "$env" ${ref:+"$ref"}
    elif ! stack_running "$env" || ! health_check "$env" >/dev/null 2>&1; then
        if image_exists "spmb-app:$tag" && image_exists "spmb-web:$tag"; then
            step "$env is not running: starting the same image $tag again"
            lock
            install_host_bits
            activate "$env" "$tag"
        else
            warn "Images for $tag are gone; deploying again."
            cmd_deploy "$env"
        fi
    else
        say "   $env already runs $tag and answers. Newer code: spmb deploy $env"
    fi

    local admins; admins="$(superadmin_count "$env")"
    if [ "$admins" = 0 ]; then
        if [ -t 0 ]; then
            step "First Super Admin of $env"
            dc "$env" exec app php spark spmb:install
        else
            warn "No Super Admin yet; run in a terminal: spmb spark $env spmb:install"
        fi
    fi

    local port clients
    port="$(get_var "$dir/stack.env" SPMB_PORT)"
    clients="$(find "$SRC/clients" -mindepth 2 -maxdepth 2 -name branding -type d 2>/dev/null | sed "s|^$SRC/||" | tr '\n' ' ')"
    say
    say "$env is up: https://$(get_var "$dir/stack.env" SPMB_DOMAIN)/ -> http://127.0.0.1:$port"
    say " - Tunnel route (once): $(get_var "$dir/stack.env" SPMB_DOMAIN) -> http://127.0.0.1:$port$( [ "$env" = staging ] && echo ' (behind Access)')"
    [ -z "$clients" ] || say " - School branding (once): spmb spark $env spmb:branding <one of: $clients>"
    [ "$env" = production ] || say " - Then: spmb up production <domain>"
    say " - Whole server: spmb check"
}

cmd_check() {
    local here
    here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    SPMB_ROOT="$SPMB_ROOT" SPMB_SRC="$SRC" bash "$here/check.sh" "$@"
}

# --- domain --------------------------------------------------------------------------------
# Change the public domain of an environment. Passwords, key, port, data and image stay as they are.
cmd_domain() {
    local env="${1:-}" domain="${2:-}" dir old
    check_env "$env"
    valid_domain "$domain" || die "Give the new domain, e.g. spmb domain $env spmb.example.sch.id"
    need_root
    require_init "$env"
    dir="$(env_dir "$env")"
    old="$(get_var "$dir/stack.env" SPMB_DOMAIN)"
    if [ "$old" = "$domain" ]; then
        say "   $env already uses $domain; nothing to change."
        return 0
    fi
    [ "$env" = production ] && confirm "Change the PRODUCTION domain from $old to $domain?"
    lock

    step "Domain of $env: $old -> $domain"
    cp -p "$dir/stack.env" "$dir/stack.env.before-domain"
    cp -p "$dir/app.env" "$dir/app.env.before-domain"
    set_var "$dir/stack.env" SPMB_DOMAIN "$domain"
    if grep -q '^app\.baseURL' "$dir/app.env"; then
        sed -i "s|^app\.baseURL.*|app.baseURL = 'https://$domain/'|" "$dir/app.env"
    else
        printf "app.baseURL = 'https://%s/'\n" "$domain" >> "$dir/app.env"
    fi
    chown root:33 "$dir/app.env"
    chmod 0640 "$dir/app.env"
    chmod 0600 "$dir/stack.env"
    say "   stack.env and app.env updated (old copies: *.before-domain)."

    if stack_running "$env"; then
        dc "$env" restart app >/dev/null
        health_check "$env" || warn "The app did not answer on the new domain; check 'spmb logs $env app'."
    else
        say "   $env is not running; the new domain applies at the next 'spmb deploy $env'."
    fi

    cat <<NEXT

Next, in Cloudflare (docs/deployment.md, "Changing a domain"):
 - Tunnel route: $domain -> http://127.0.0.1:$(get_var "$dir/stack.env" SPMB_PORT)
 - Keep $old for a while with a 301 Redirect Rule to https://$domain (links already shared keep working).
NEXT
    if [ "$env" = staging ]; then
        say " - Access application: replace $old with $domain (staging stays behind Access)."
    else
        say " - Update the school's website address in Pengaturan → Identitas Sekolah."
    fi
    say " - People signed in on $old sign in again on $domain."
}

cmd_rollback() {
    local env="${1:-}" dir current previous
    check_env "$env"
    need_root
    require_init "$env"
    lock
    dir="$(env_dir "$env")"
    current="$(get_var "$dir/stack.env" SPMB_TAG)"
    previous="$(get_var "$dir/stack.env" SPMB_PREVIOUS_TAG)"
    [ -n "$previous" ] || die "No previous image recorded for $env."
    image_exists "spmb-app:$previous" || die "Image spmb-app:$previous no longer exists."
    confirm "Roll $env back from $current to $previous? (the database is not rolled back)"
    local sha; sha="$(image_commit "$previous")"
    git -C "$SRC" show "$sha:deploy/compose.yaml" > "$dir/compose.yaml"
    set_var "$dir/stack.env" SPMB_TAG "$previous"
    set_var "$dir/stack.env" SPMB_PREVIOUS_TAG "$current"
    dc "$env" up -d --remove-orphans --wait --wait-timeout 300
    health_check "$env"
    printf '%s %s %s %s rollback\n' "$(date -Iseconds)" "$env" "$previous" "$sha" >> "$dir/deploys.log"
    say "spmb-$env runs $previous again. Migrations are not undone; restore a backup if needed."
}

cmd_status() {
    local env dir
    for env in staging production; do
        dir="$(env_dir "$env")"
        printf '\n== %s\n' "$env"
        if [ ! -f "$dir/stack.env" ]; then say "   not initialised"; continue; fi
        local tag; tag="$(get_var "$dir/stack.env" SPMB_TAG)"
        say "   domain   $(get_var "$dir/stack.env" SPMB_DOMAIN)"
        say "   port     127.0.0.1:$(get_var "$dir/stack.env" SPMB_PORT)"
        say "   image    ${tag:-none} $( [ -z "$tag" ] || git -C "$SRC" log -1 --format='(%cs %s)' "$(image_commit "$tag")" 2>/dev/null || true)"
        say "   previous $(get_var "$dir/stack.env" SPMB_PREVIOUS_TAG)"
        say "   backups  $(find "$dir/backups" -name "spmb-$env-*.tar" 2>/dev/null | wc -l) (latest: $(find "$dir/backups" -name "spmb-$env-*.tar" -printf '%f\n' 2>/dev/null | sort | tail -n 1))"
        [ -f "$dir/compose.yaml" ] && dc "$env" ps --format 'table {{.Service}}\t{{.Status}}' 2>/dev/null | sed 's/^/   /'
    done
    printf '\n== host\n'
    say "   cloudflared $(systemctl is-active cloudflared 2>/dev/null || echo unknown), cockpit $(systemctl is-active cockpit.socket 2>/dev/null || echo unknown)"
    say "   disk $(df -h "$SPMB_ROOT" | awk 'NR == 2 {print $4 " free of " $2}')"
    if [ -f "$OFFSITE_FILE" ]; then
        say "   offsite last upload $(cat "$OFFSITE_LAST" 2>/dev/null || echo none) (spmb offsite status)"
    else
        say "   offsite not set up (spmb offsite setup)"
    fi
}

cmd_logs() {
    local env="${1:-}"; shift || true
    check_env "$env"
    require_init "$env"
    dc "$env" logs --tail 200 -f "$@"
}

cmd_spark() {
    local env="${1:-}"; shift || true
    check_env "$env"
    require_init "$env"
    [ "$#" -gt 0 ] || die "Usage: spmb spark <env> <command> [args...]"
    local t; t="$(tty_flag)"
    # shellcheck disable=SC2086 # $t is empty or -T
    dc "$env" exec $t app php spark "$@"
}

# --- backup / restore ----------------------------------------------------------------------
cmd_backup() {
    local env="${1:-}"
    check_env "$env"
    need_root
    require_init "$env"
    lock
    cmd_backup_unlocked "$env"
    # Daily and manual backups also go off-site; the backup before a deploy stays local.
    if [ -f "$OFFSITE_FILE" ]; then
        offsite_push "$env" "$LAST_BACKUP" || die "The local backup is fine, but the off-site copy failed (see above)."
    fi
}

cmd_backup_unlocked() {
    local env="$1" dir stamp work archive
    dir="$(env_dir "$env")"
    stack_running "$env" || die "spmb-$env is not running; nothing to back up."
    stamp="$(date +%Y%m%d-%H%M%S)"
    work="$(mktemp -d)"
    archive="$dir/backups/spmb-$env-$stamp.tar"
    install -d -m 0700 "$dir/backups"

    dc "$env" exec -T db sh -c 'exec mysqldump --single-transaction --quick --routines --triggers \
        --no-tablespaces --default-character-set=utf8mb4 -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE"' \
        2> >(grep -v 'Using a password' >&2) | gzip -6 > "$work/db.sql.gz"
    dc "$env" exec -T app tar -C /var/www/html/writable -czf - uploads > "$work/uploads.tar.gz"
    cp "$dir/app.env" "$work/app.env"
    {
        printf 'env=%s\n' "$env"
        printf 'created=%s\n' "$(date -Iseconds)"
        printf 'tag=%s\n' "$(get_var "$dir/stack.env" SPMB_TAG)"
        printf 'commit=%s\n' "$(image_commit "$(get_var "$dir/stack.env" SPMB_TAG)")"
    } > "$work/backup.info"
    (umask 077 && tar -C "$work" -cf "$archive" backup.info db.sql.gz uploads.tar.gz app.env)
    rm -rf "$work"
    find "$dir/backups" -name "spmb-$env-*.tar" -mtime +$((KEEP_BACKUP_DAYS - 1)) -delete
    LAST_BACKUP="$archive"
    say "   Backup: $archive ($(du -h "$archive" | cut -f1))"
}

# --- off-site backups (restic, D-079) -------------------------------------------------------
# One restic repository for the server; snapshots are tagged with the environment. restic
# encrypts everything with RESTIC_PASSWORD before it leaves the server.
restic_run() {
    [ -f "$OFFSITE_FILE" ] || die "Off-site backups are not set up. Run: spmb offsite setup"
    command -v restic >/dev/null || die "restic is not installed (apt-get install restic, or run setup.sh again)."
    (
        set -a
        # shellcheck disable=SC1090
        . "$OFFSITE_FILE"
        set +a
        export RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-/var/cache/restic}"
        restic "$@"
    )
}

offsite_push() {
    local env="$1" archive="$2"
    step "Off-site copy ($env)"
    restic_run backup --quiet --host "$OFFSITE_HOST" --tag "$env" "$archive" || return 1
    # Snapshots differ by file name, so group by tag to apply the retention per environment.
    restic_run forget --quiet --host "$OFFSITE_HOST" --tag "$env" --group-by host,tags \
        --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune || return 1
    printf '%s %s\n' "$(date -Iseconds)" "$(basename "$archive")" > "$OFFSITE_LAST"
    say "   Off-site: $(basename "$archive") uploaded (kept: 14 daily, 8 weekly, 12 monthly)."
}

cmd_offsite() {
    local sub="${1:-status}"; shift || true
    need_root
    case "$sub" in
        setup)  offsite_setup ;;
        status) offsite_status ;;
        get)    offsite_get "$@" ;;
        *)      die "Usage: spmb offsite setup | status | get <env> [snapshot]" ;;
    esac
}

offsite_setup() {
    local url key_id secret password repo
    if [ -f "$OFFSITE_FILE" ]; then
        say "   Off-site backups are already set up ($OFFSITE_FILE). Edit that file to change the keys."
        restic_run snapshots --compact >/dev/null && say "   Connection OK."
        return 0
    fi
    [ -t 0 ] || die "spmb offsite setup asks questions; run it in a terminal."
    command -v restic >/dev/null || { step "Installing restic"; apt-get install -y -q restic >/dev/null; }
    lock
    step "Off-site backups (Cloudflare R2 or another S3 bucket)"
    say "   Bucket URL, e.g. https://<account id>.r2.cloudflarestorage.com/<bucket>"
    read -r -p "   Bucket URL: " url
    url="${url%/}"
    [[ "$url" =~ ^https://[A-Za-z0-9.-]+/[a-z0-9][a-z0-9.-]{1,62}$ ]] \
        || die "Give https://<host>/<bucket> (no path after the bucket name)."
    read -r -p "   Access Key ID: " key_id
    read -r -s -p "   Secret Access Key (hidden): " secret; echo
    [[ "$key_id" =~ ^[A-Za-z0-9]+$ && "$secret" =~ ^[A-Za-z0-9/+=]+$ ]] || die "The keys look wrong (letters and digits only)."
    password="$(openssl rand -hex 32)"
    repo="s3:$url/spmb"

    (umask 077 && cat > "$OFFSITE_FILE" <<OFFSITE
# Off-site backups of SPMB (made by spmb offsite setup). Keep it on the server; never commit it.
# RESTIC_PASSWORD encrypts the backups: without it they cannot be read. Keep a copy in the password manager.
RESTIC_REPOSITORY='$repo'
AWS_ACCESS_KEY_ID='$key_id'
AWS_SECRET_ACCESS_KEY='$secret'
AWS_DEFAULT_REGION='auto'
RESTIC_PASSWORD='$password'
OFFSITE
    )
    install -d -m 0700 /var/cache/restic
    if restic_run cat config >/dev/null 2>&1; then
        warn "A restic repository already exists at $repo; it needs its own password. Put it in $OFFSITE_FILE (RESTIC_PASSWORD)."
        return 1
    fi
    if ! restic_run init >/dev/null; then
        rm -f "$OFFSITE_FILE"
        die "Could not create the repository in the bucket (check the URL, the keys and the token's bucket access)."
    fi
    say "   Repository created: $repo"
    cat <<NOTE

   SAVE THIS IN THE PASSWORD MANAGER NOW (title: "SPMB off-site backup"), together with the
   bucket URL and both keys (or the whole file: cat $OFFSITE_FILE). Without this password
   the off-site backups cannot be decrypted, also not by Arumi Studios:

      $password

   It is also in $OFFSITE_FILE (root only). From now on 'spmb backup <env>' and the daily
   timer upload an encrypted copy. First upload now: spmb backup production
NOTE
}

offsite_status() {
    step "Off-site backups"
    [ -f "$OFFSITE_FILE" ] || { say "   not set up (spmb offsite setup)"; return 0; }
    say "   repository $(sed -n "s/^RESTIC_REPOSITORY='\(.*\)'$/\1/p" "$OFFSITE_FILE" | sed 's|//[^.]*\.|//…|')"
    say "   last upload $(cat "$OFFSITE_LAST" 2>/dev/null || echo none)"
    restic_run snapshots --compact --host "$OFFSITE_HOST"
}

offsite_get() {
    local env="${1:-}" id="${2:-latest}" dir work file
    check_env "$env"
    require_init "$env"
    dir="$(env_dir "$env")"
    work="$(mktemp -d)"
    step "Downloading off-site backup $id ($env)"
    if [ "$id" = latest ]; then
        restic_run restore latest --host "$OFFSITE_HOST" --tag "$env" --target "$work" >/dev/null
    else
        restic_run restore "$id" --target "$work" >/dev/null
    fi
    file="$(find "$work" -type f -name "spmb-*.tar" | head -n 1)"
    [ -n "$file" ] || { rm -rf "$work"; die "No backup archive in that snapshot."; }
    install -d -m 0700 "$dir/backups"
    mv "$file" "$dir/backups/"
    rm -rf "$work"
    say "   Saved: $dir/backups/$(basename "$file")"
    say "   Restore it with: spmb restore $env $dir/backups/$(basename "$file")"
}

cmd_restore() {
    local env="${1:-}" file="${2:-}" dir work from key
    check_env "$env"
    need_root
    require_init "$env"
    [ -f "$file" ] || die "Usage: spmb restore <env> <backup.tar>"
    lock
    dir="$(env_dir "$env")"
    work="$(mktemp -d)"
    tar -C "$work" -xf "$file" backup.info db.sql.gz uploads.tar.gz app.env \
        || die "$file is not an spmb backup."
    from="$(sed -n 's/^env=//p' "$work/backup.info")"
    # UU PDP (D-067): production holds real personal data; it never goes to staging.
    if [ "$from" = production ] && [ "$env" = staging ]; then
        rm -rf "$work"
        die "A production backup cannot be restored on staging (personal data stays in production)."
    fi
    stack_running "$env" || die "spmb-$env is not running. Deploy it first (spmb deploy $env), then restore."
    say "Backup of '$from' from $(sed -n 's/^created=//p' "$work/backup.info") (image $(sed -n 's/^tag=//p' "$work/backup.info"))."
    confirm "Replace ALL data of $env (database and uploaded files) with this backup?"

    step "Safety backup of the current data"
    cmd_backup_unlocked "$env"

    step "Database"
    dc "$env" exec -T db sh -c 'exec mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "DROP DATABASE IF EXISTS \`$MYSQL_DATABASE\`; CREATE DATABASE \`$MYSQL_DATABASE\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"' \
        2> >(grep -v 'Using a password' >&2)
    gunzip -c "$work/db.sql.gz" | dc "$env" exec -T db sh -c 'exec mysql -uroot -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE"' \
        2> >(grep -v 'Using a password' >&2)

    step "Uploaded files"
    dc "$env" exec -T app sh -c 'rm -rf /var/www/html/writable/uploads && tar -C /var/www/html/writable -xzf -' \
        < "$work/uploads.tar.gz"

    # Encrypted data (2FA secrets) only opens with the key it was made with.
    key="$(sed -n 's/^encryption\.key = //p' "$work/app.env" | tail -n 1)"
    if [ -n "$key" ] && [ "$key" != "$(sed -n 's/^encryption\.key = //p' "$dir/app.env" | tail -n 1)" ]; then
        cp "$dir/app.env" "$dir/app.env.before-restore"
        sed -i "s|^encryption\.key = .*|encryption.key = $key|" "$dir/app.env"
        say "   encryption.key taken from the backup (old file: app.env.before-restore)."
    fi
    rm -rf "$work"

    dc "$env" restart app >/dev/null
    dc "$env" exec -T app php spark migrate --all
    dc "$env" exec -T app php spark cache:clear >/dev/null 2>&1 || true
    health_check "$env"
    say "Restore of $env finished."
}

# --- dispatch ------------------------------------------------------------------------------
local args=()
for a in "$@"; do
    case "$a" in
        -y|--yes) ASSUME_YES=1 ;;
        -h|--help) usage; return 0 ;;
        *) args+=("$a") ;;
    esac
done
set -- "${args[@]+"${args[@]}"}"

local cmd="${1:-}"; shift || true
case "$cmd" in
    check)    cmd_check "$@" ;;
    up)       cmd_up "$@" ;;
    init)     cmd_init "$@" ;;
    deploy)   cmd_deploy "$@" ;;
    rollback) cmd_rollback "$@" ;;
    status)   cmd_status ;;
    logs)     cmd_logs "$@" ;;
    backup)   cmd_backup "$@" ;;
    restore)  cmd_restore "$@" ;;
    spark)    cmd_spark "$@" ;;
    domain)   cmd_domain "$@" ;;
    offsite)  cmd_offsite "$@" ;;
    ''|help)  usage ;;
    *)        usage >&2; die "Unknown command '$cmd'." ;;
esac
}

main "$@"; exit $?
