# Example of /opt/apps/spmb/staging/app.env — the CodeIgniter .env of the SPMB staging stack.
# `spmb init staging staging.spmbsmpnualmarufkudus.web.id` writes the real file (owner root, group www-data, mode 640) and the
# app container reads it read-only as /var/www/html/.env. Never commit the real file.

# Staging holds test data only: never restore a production backup into it (D-067, UU PDP).

# Staging also runs as production, so it behaves exactly like the live site (D-076);
# that is why `spmb:install --demo` is refused on staging.
CI_ENVIRONMENT = production

# Public address of this environment, with the trailing slash.
app.baseURL = 'https://staging.spmbsmpnualmarufkudus.web.id/'

# The database is the `db` service of this stack (not localhost). The password must equal
# SPMB_DB_PASSWORD in stack.env.
database.default.hostname = db
database.default.database = spmb
database.default.username = spmb
database.default.password = <same value as SPMB_DB_PASSWORD>
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# Protects the 2FA secrets and other encrypted data. Made by init with `openssl rand -hex 32`.
# Keep a copy in the password manager: without it, a restored backup cannot read that data.
# Staging and production each have their own key; never copy one to the other.
encryption.key = hex2bin:<64 hex characters>
