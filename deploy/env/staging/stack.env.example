# Example of /opt/apps/spmb/staging/stack.env — Docker Compose settings of the SPMB staging stack.
# `spmb init staging staging.spmbsmpnualmarufkudus.web.id` writes the real file (mode 600) with fresh random values;
# this example only shows its shape. Never commit the real file or put real values here.
# Staging holds test data only: never copy production personal data into it (D-067, UU PDP).
# The values below are for the first client (D-050, D-065, D-067); another school uses its own domain.

# Which stack this is: staging or production (compose project spmb-staging).
SPMB_ENV=staging

# Domain of this environment (used for the tunnel hostname and app.baseURL in app.env).
SPMB_DOMAIN=staging.spmbsmpnualmarufkudus.web.id

# Local port of the web container, 127.0.0.1 only; taken from /opt/apps/PORTS (8100–8199) by init.
# cloudflared forwards https://staging.spmbsmpnualmarufkudus.web.id to http://127.0.0.1:<this port>.
# Example value: init takes the first free port, so staging usually gets 8100.
SPMB_PORT=8100

# Image tags, set by `spmb deploy` and `spmb rollback`; leave empty before the first deploy.
SPMB_TAG=
SPMB_PREVIOUS_TAG=

# MySQL passwords of this stack's own database (made by init with `openssl rand -hex 24`).
# SPMB_DB_PASSWORD must equal database.default.password in app.env.
SPMB_DB_PASSWORD=<48 hex characters>
SPMB_DB_ROOT_PASSWORD=<48 hex characters, different from the one above>

# Optional: InnoDB buffer pool of this stack's MySQL (default 256M).
# SPMB_DB_BUFFER_POOL=256M
