{
    "name": "arumiforge/spmb",
    "description": "SPMB - white-label school admission system (CodeIgniter 4) by Arumi Studios",
    "license": "proprietary",
    "type": "project",
    "authors": [
        {
            "name": "Arumi Studios",
            "email": "arumiforge@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/shield": "^1.2",
        "codeigniter4/translations": "^4.7",
        "pragmarx/google2fa": "^8.0"
    },
    "require-dev": {
        "codeigniter/coding-standard": "^1.8",
        "fakerphp/faker": "^1.24",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Modules\\": "app/Modules/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "post-update-cmd": [
            "@php -r \"is_dir('.git') && exec('git config core.hooksPath .githooks');\""
        ],
        "post-install-cmd": [
            "@php -r \"is_dir('.git') && exec('git config core.hooksPath .githooks');\""
        ]
    }
}
